`timescale 1ns/1ps

module top_tb;

    parameter CLK       = 50_000_000;
    parameter BAUD_RATE = 115200;

    reg  clk;
    reg  rst;
    reg  rx;
    wire led;

    localparam integer CLOCKS_PER_BIT = CLK / BAUD_RATE;
    localparam integer BIT_TIME_NS   = 1_000_000_000 / BAUD_RATE;

    // DUT
    top #(
        .CLK(CLK),
        .BAUD_RATE(BAUD_RATE)
    ) dut (
        .rx  (rx),
        .rst (rst),
        .clk (clk),
        .led (led)
    );

    // ------------------------------------------------
    // FST waveform dump
    // ------------------------------------------------
    initial begin
        $dumpfile("top_tb.fst");
        $dumpvars(0, top_tb);
    end

    // ------------------------------------------------
    // 50 MHz clock
    // 20 ns period
    // ------------------------------------------------
    initial begin
        clk = 1'b0;
        forever #10 clk = ~clk;
    end

    // ------------------------------------------------
    // UART transmitter: 8-N-1
    // ------------------------------------------------
    task uart_send_byte;
        input [7:0] data_byte;
        integer i;

        begin
            // Start bit
            rx = 1'b0;
            #(BIT_TIME_NS);

            // Data bits, LSB first
            for (i = 0; i < 8; i = i + 1) begin
                rx = data_byte[i];
                #(BIT_TIME_NS);
            end

            // Stop bit
            rx = 1'b1;
            #(BIT_TIME_NS);

            // Idle
            #(BIT_TIME_NS);
        end
    endtask

    // ------------------------------------------------
    // Test sequence
    // ------------------------------------------------
    initial begin

        rx  = 1'b1;
        rst = 1'b1;

        // Reset
        #200;

        rst = 1'b0;

        #200;

        // Send AB -> LED ON
        $display("Sending 0xAB...");
        uart_send_byte(8'hAB);

        #1000;

        if (led === 1'b1)
            $display("TEST 1 PASS: LED ON");
        else
            $display("TEST 1 FAIL: LED should be ON");

        // Send FF -> LED OFF
        $display("Sending 0xFF...");
        uart_send_byte(8'hFF);

        #1000;

        if (led === 1'b0)
            $display("TEST 2 PASS: LED OFF");
        else
            $display("TEST 2 FAIL: LED should be OFF");

        // Send 55 -> LED should remain OFF
        $display("Sending 0x55...");
        uart_send_byte(8'h55);

        #1000;

        if (led === 1'b0)
            $display("TEST 3 PASS: LED remains OFF");
        else
            $display("TEST 3 FAIL: LED changed unexpectedly");

        #1000;

        $display("Simulation completed.");
        $finish;
    end

endmodule