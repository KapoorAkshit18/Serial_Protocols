`timescale 1ns / 1ps

// ============================================================================
// TESTBENCH : I2C SLAVE LED CONTROLLER
// ============================================================================
//
// System clock:
//     50 MHz
//
// I2C clock:
//     100 kHz
//
// Slave address:
//     7'h32
//
// Tests:
//     1. 0xAA -> LED ON
//     2. 0x55 -> LED remains ON
//     3. 0xFF -> LED OFF
//     4. 0xAA -> LED ON again
//     5. Wrong address -> LED unchanged
//
// ============================================================================

module tb;

    parameter [6:0] SLAVE_ADDR = 7'h32;

    parameter SYS_CLK_PERIOD  = 20;
    parameter I2C_HALF_PERIOD = 5000;


    // =========================================================================
    // SYSTEM
    // =========================================================================

    reg clk;
    reg rst;
    reg en;


    // =========================================================================
    // I2C MASTER
    // =========================================================================

    reg master_sda_oe;
    reg master_scl;


    // =========================================================================
    // I2C BUS
    // =========================================================================

    tri1 sda_bus;


    // Master open-drain driver.
    assign sda_bus =
            master_sda_oe ? 1'b0 : 1'bz;


    // =========================================================================
    // DUT OUTPUTS
    // =========================================================================

    wire slave_sda;
    wire slave_sda_oe;

    wire led;
    wire led_en;

    wire clk_en;

    wire [7:0] data_rx;
    wire int_rx;

    wire busy;


    // =========================================================================
    // SLAVE OPEN-DRAIN DRIVER
    // =========================================================================

    assign sda_bus =
            slave_sda_oe ? 1'b0 : 1'bz;


    // =========================================================================
    // DUT
    // =========================================================================

    top #(
        .I2C_SLAVE_ADR(SLAVE_ADDR)
    )
    dut (

        .i_clk       (clk),
        .i_rst       (rst),
        .i_en        (en),

        .i_scl       (master_scl),
        .i_sda       (sda_bus),

        .o_sda       (slave_sda),
        .o_sda_oe    (slave_sda_oe),

        .o_led       (led),
        .o_led_en    (led_en),

        .o_clk_en    (clk_en),

        .o_data_rx   (data_rx),
        .o_int_rx    (int_rx),

        .o_busy      (busy)

    );


    // =========================================================================
    // 50 MHz CLOCK
    // =========================================================================

    initial begin

        clk = 1'b0;

        forever begin

            #10 clk = ~clk;

        end

    end


    // =========================================================================
    // MAIN TEST
    // =========================================================================

    initial begin

        $dumpfile("i2c_tb.vcd");

        $dumpvars(0, tb);


        // ---------------------------------------------------------------------
        // Initial I2C idle state
        // ---------------------------------------------------------------------

        master_scl    = 1'b1;
        master_sda_oe = 1'b0;

        rst = 1'b1;
        en  = 1'b0;


        $display("");
        $display("======================================================");
        $display("             I2C SLAVE LED TESTBENCH");
        $display("======================================================");


        // ---------------------------------------------------------------------
        // RESET
        // ---------------------------------------------------------------------

        $display("[TEST] Applying reset...");

        #200;

        rst = 1'b0;

        #500;

        en = 1'b1;

        #500;

        $display("[TEST] Reset released.");
        $display("");


        // =====================================================================
        // TEST 1
        // =====================================================================

        $display("----------------------------------------------");
        $display("TEST 1 : WRITE 0xAA");
        $display("Expected : LED ON");
        $display("----------------------------------------------");

        i2c_write(
            SLAVE_ADDR,
            8'hAA
        );

        #2000;

        if (led === 1'b1)
            $display("[PASS] LED turned ON.");
        else
            $display("[FAIL] LED did not turn ON. LED=%b", led);


        // =====================================================================
        // TEST 2
        // =====================================================================

        $display("");
        $display("----------------------------------------------");
        $display("TEST 2 : WRITE 0x55");
        $display("Expected : LED remains ON");
        $display("----------------------------------------------");

        i2c_write(
            SLAVE_ADDR,
            8'h55
        );

        #2000;

        if (led === 1'b1)
            $display("[PASS] LED remained ON.");
        else
            $display("[FAIL] LED changed unexpectedly. LED=%b", led);


        // =====================================================================
        // TEST 3
        // =====================================================================

        $display("");
        $display("----------------------------------------------");
        $display("TEST 3 : WRITE 0xFF");
        $display("Expected : LED OFF");
        $display("----------------------------------------------");

        i2c_write(
            SLAVE_ADDR,
            8'hFF
        );

        #2000;

        if (led === 1'b0)
            $display("[PASS] LED turned OFF.");
        else
            $display("[FAIL] LED did not turn OFF. LED=%b", led);


        // =====================================================================
        // TEST 4
        // =====================================================================

        $display("");
        $display("----------------------------------------------");
        $display("TEST 4 : WRITE 0xAA AGAIN");
        $display("Expected : LED ON");
        $display("----------------------------------------------");

        i2c_write(
            SLAVE_ADDR,
            8'hAA
        );

        #2000;

        if (led === 1'b1)
            $display("[PASS] LED turned ON again.");
        else
            $display("[FAIL] LED did not turn ON again. LED=%b", led);


        // =====================================================================
        // TEST 5
        // =====================================================================

        $display("");
        $display("----------------------------------------------");
        $display("TEST 5 : WRONG SLAVE ADDRESS");
        $display("Expected : LED unchanged");
        $display("----------------------------------------------");

        i2c_write(
            7'h18,
            8'hFF
        );

        #2000;

        if (led === 1'b1)
            $display("[PASS] Wrong address ignored.");
        else
            $display("[FAIL] Wrong address changed LED. LED=%b", led);


        // =====================================================================
        // FINAL
        // =====================================================================

        $display("");
        $display("======================================================");
        $display("             ALL I2C TESTS COMPLETE");
        $display("======================================================");
        $display("");

        #5000;

        $finish;

    end


    // =========================================================================
    // I2C WRITE
    // =========================================================================

    task i2c_write;

        input [6:0] address;
        input [7:0] data;

        integer i;

        begin

            $display(
                "[I2C WRITE] ADDR=0x%02h DATA=0x%02h",
                address,
                data
            );


            // -----------------------------------------------------------------
            // START
            // -----------------------------------------------------------------

            i2c_start();


            // -----------------------------------------------------------------
            // 7-bit address
            // -----------------------------------------------------------------

            for (i = 6; i >= 0; i = i - 1) begin

                i2c_write_bit(address[i]);

            end


            // -----------------------------------------------------------------
            // WRITE bit
            // -----------------------------------------------------------------

            i2c_write_bit(1'b0);


            // -----------------------------------------------------------------
            // Slave ACK
            // -----------------------------------------------------------------

            i2c_read_ack();


            // -----------------------------------------------------------------
            // DATA
            // -----------------------------------------------------------------

            for (i = 7; i >= 0; i = i - 1) begin

                i2c_write_bit(data[i]);

            end


            // -----------------------------------------------------------------
            // Slave ACK
            // -----------------------------------------------------------------

            i2c_read_ack();


            // -----------------------------------------------------------------
            // STOP
            // -----------------------------------------------------------------

            i2c_stop();


            $display(
                "[I2C RX] DATA_RX=0x%02h LED=%b",
                data_rx,
                led
            );

        end

    endtask


    // =========================================================================
    // START
    // =========================================================================

    task i2c_start;

        begin

            // Idle.
            master_scl    = 1'b1;
            master_sda_oe = 1'b0;

            #I2C_HALF_PERIOD;

            // START:
            // SDA HIGH -> LOW while SCL HIGH.
            master_sda_oe = 1'b1;

            #I2C_HALF_PERIOD;

            // Begin transaction.
            master_scl = 1'b0;

            #I2C_HALF_PERIOD;

        end

    endtask


    // =========================================================================
    // STOP
    // =========================================================================

    task i2c_stop;

        begin

            // SCL LOW.
            master_scl = 1'b0;

            // SDA LOW.
            master_sda_oe = 1'b1;

            #I2C_HALF_PERIOD;

            // SCL HIGH.
            master_scl = 1'b1;

            #I2C_HALF_PERIOD;

            // STOP:
            // SDA LOW -> HIGH while SCL HIGH.
            master_sda_oe = 1'b0;

            #I2C_HALF_PERIOD;

        end

    endtask


    // =========================================================================
    // WRITE ONE BIT
    // =========================================================================

    task i2c_write_bit;

        input bit_value;

        begin

            // -----------------------------------------------------------------
            // SCL LOW
            // -----------------------------------------------------------------

            master_scl = 1'b0;


            // -----------------------------------------------------------------
            // Set SDA
            // -----------------------------------------------------------------

            if (bit_value == 1'b0)
                master_sda_oe = 1'b1;
            else
                master_sda_oe = 1'b0;


            // Data setup.
            #I2C_HALF_PERIOD;


            // -----------------------------------------------------------------
            // SCL HIGH
            // -----------------------------------------------------------------

            master_scl = 1'b1;

            // Data valid during HIGH.
            #I2C_HALF_PERIOD;


            // -----------------------------------------------------------------
            // SCL LOW
            // -----------------------------------------------------------------

            master_scl = 1'b0;

            #I2C_HALF_PERIOD;

        end

    endtask


    // =========================================================================
    // READ ACK
    // =========================================================================

    task i2c_read_ack;

        reg ack_value;

        begin

            // -----------------------------------------------------------------
            // Master releases SDA.
            // -----------------------------------------------------------------

            master_sda_oe = 1'b0;

            #I2C_HALF_PERIOD;


            // -----------------------------------------------------------------
            // 9th clock HIGH
            // -----------------------------------------------------------------

            master_scl = 1'b1;

            #2000;


            // -----------------------------------------------------------------
            // Sample ACK
            // -----------------------------------------------------------------

            ack_value = sda_bus;

            if (ack_value === 1'b0)
                $display("[I2C] ACK received.");
            else
                $display("[I2C] ERROR: NACK received. SDA=%b", ack_value);


            #3000;


            // -----------------------------------------------------------------
            // Clock LOW
            // -----------------------------------------------------------------

            master_scl = 1'b0;

            #I2C_HALF_PERIOD;

        end

    endtask


endmodule